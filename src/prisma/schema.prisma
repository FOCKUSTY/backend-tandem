generator client {
  provider               = "prisma-client"
  output                 = "./generated"
  moduleFormat           = "cjs"
  generatedFileExtension = "ts"
  compilerBuild          = "fast"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String   @id @default(uuid(7))
  username String   @unique
  password String
  name     String?
  records  Record[]

  pairId   String?
  pair     Pair?    @relation("PairUsers", fields: [pairId], references: [id])

  pairsA Pair[] @relation("PairUsersA")
  pairsB Pair[] @relation("PairUsersB")

  pushTokens PushToken[]
}

model PushToken {
  id        String   @id @default(uuid(7))
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Pair {
  id        String   @id @default(uuid(7))
  userAId   String
  userBId   String
  userA     User     @relation("PairUsersA", fields: [userAId], references: [id])
  userB     User     @relation("PairUsersB", fields: [userBId], references: [id])
  users     User[]   @relation("PairUsers")

  sections  Section[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userAId, userBId])
}

model Section {
  id        String   @id @default(uuid(7))
  pairId    String
  pair      Pair     @relation(fields: [pairId], references: [id])
  name      String
  slug      String
  isSystem  Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  records   Record[]

  @@unique([pairId, slug])
}

model Record {
  id          String    @id @default(uuid(7))
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  sectionId   String
  section     Section   @relation(fields: [sectionId], references: [id])
  title       String?
  content     String?
  dateEvent   DateTime?
  isCompleted Boolean   @default(false)
  isPinned    Boolean   @default(false)
  tags        String[]  @default([])
  metadata    Json      @default("{}")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, sectionId])
  @@index([userId, sectionId, dateEvent])
  @@index([userId, updatedAt])
}